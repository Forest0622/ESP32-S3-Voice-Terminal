# ATK-DNESP32S3 V1.3 : ESP32-S3 N16R8（16MB Flash + 8MB Octal PSRAM）
CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# esp_codec_dev 的 ES8388 驱动在 IDF≥5.3 默认走新版 i2c_master 总线；
# 本工程的 I2C 已整体迁移到 i2c_new_master_bus，总线句柄经 audio_codec_i2c_cfg_t 交给 codec，
# 因此这里必须关闭旧驱动兼容，否则会和板级 I2C 冲突并在启动时 abort()
# CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE is not set

# ---- LVGL 9 ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE=98304
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_USE_LOG=n
CONFIG_LV_USE_ASSERT_NULL=n
CONFIG_LV_USE_ASSERT_MALLOC=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_MEM_MONITOR=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set

# ---- 应用参数（可在 menuconfig 里改）----
CONFIG_VOICE_WIFI_SSID=""
CONFIG_VOICE_WIFI_PASSWORD=""
CONFIG_VOICE_SERVER_URL="ws://192.168.1.100:8765/ws"
